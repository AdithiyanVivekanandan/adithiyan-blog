---
import ArticleCard from "../../components/ArticleCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedArticles } from "../../lib/articles";
import { collectionPageStructuredData } from "../../lib/seo";

const articles = await getPublishedArticles();
const site = Astro.site;

if (!site) {
  throw new Error("astro.config.mjs must define site for article metadata");
}

const structuredData = [
  collectionPageStructuredData(site, {
    path: "/articles/",
    name: "Articles",
    description:
      "All published articles from Technical Fieldnotes, newest first.",
    articles: articles.map((article) => ({
      slug: article.data.slug,
      title: article.data.title,
    })),
  }),
];
---

<BaseLayout
  title="Articles"
  description="All published articles from Technical Fieldnotes, newest first."
  structuredData={structuredData}
>
  <h1 class="page-title">Articles</h1>
  <p class="page-intro">Newest first.</p>

  {articles.length > 0 ? (
    <ul class="article-list article-list--index">
      {articles.map((article) => (
        <ArticleCard article={article} headingLevel={2} />
      ))}
    </ul>
  ) : (
    <p class="empty-state">No articles have been published yet.</p>
  )}
</BaseLayout>
