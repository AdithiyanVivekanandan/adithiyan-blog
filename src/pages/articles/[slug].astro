---
import { render } from "astro:content";
import { AUTHOR } from "../../consts";
import ArticleCard from "../../components/ArticleCard.astro";
import ArticlePager from "../../components/ArticlePager.astro";
import ArticleToc from "../../components/ArticleToc.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articleTypeLabel } from "../../lib/article-type";
import {
  getAdjacentArticles,
  getRelatedArticles,
} from "../../lib/article-policy";
import {
  formatArticleDate,
  getPublishedArticles,
  isoDateOnly,
  readingTimeMinutes,
  type ArticleEntry,
} from "../../lib/articles";
import { topicLabel } from "../../lib/topics";
import "../../styles/article.css";

interface Props {
  entry: ArticleEntry;
}

export async function getStaticPaths() {
  const published = await getPublishedArticles();
  return published.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;

if (data.status !== "published" || !data.publishedAt) {
  throw new Error(
    `article route rendered for non-published entry: ${entry.id}`,
  );
}

const published = await getPublishedArticles();
const { previous, next } = getAdjacentArticles(entry, published);
const related = getRelatedArticles(entry, published);

const publishedAt = data.publishedAt;
const minutes = readingTimeMinutes(entry.body ?? "");
const canonical = new URL(`/articles/${data.slug}/`, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: data.title,
  description: data.description,
  datePublished: publishedAt.toISOString(),
  ...(data.updatedAt ? { dateModified: data.updatedAt.toISOString() } : {}),
  author: { "@type": "Person", name: AUTHOR },
  mainEntityOfPage: canonical.href,
  articleSection: topicLabel(data.topics[0]),
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  publishedAt={publishedAt}
  updatedAt={data.updatedAt}
>
  <article class="article">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li>
          <a href="/">Home</a>
        </li>
        <li>
          <a href="/articles/">Articles</a>
        </li>
        <li aria-current="page">{data.title}</li>
      </ol>
    </nav>

    <header>
      <p class="article__topic">
        <span class="article__label">
          {articleTypeLabel(data.articleType)} ·{" "}
          {data.topics.map((slug) => topicLabel(slug)).join(" · ")}
        </span>
      </p>
      <h1 class="article__title">{data.title}</h1>
      {data.subtitle && <p class="article__subtitle">{data.subtitle}</p>}
      <p class="article__summary">{data.description}</p>
      <p class="article__meta">
        <span>By {AUTHOR}</span>
        <span>
          Published{" "}
          <time datetime={isoDateOnly(publishedAt)}>
            {formatArticleDate(publishedAt)}
          </time>
        </span>
        {data.updatedAt && (
          <span>
            Updated{" "}
            <time datetime={isoDateOnly(data.updatedAt)}>
              {formatArticleDate(data.updatedAt)}
            </time>
          </span>
        )}
        <span>{minutes} min read</span>
      </p>
      {data.technicalContext && (
        <aside class="article__context" aria-label="Technical context">
          <span class="article__label">Technical context</span>
          {data.technicalContext}
        </aside>
      )}
    </header>

    <ArticleToc headings={headings} />

    <div class="article__body">
      <Content />
    </div>

    <hr class="article__end" />

    {data.limitations && (
      <section
        class="article__footer-section"
        aria-labelledby="limitations-heading"
      >
        <h2 id="limitations-heading">Limitations</h2>
        <div class="article__limitations">
          <p>{data.limitations}</p>
        </div>
      </section>
    )}

    {data.references && data.references.length > 0 && (
      <section
        class="article__footer-section"
        aria-labelledby="references-heading"
      >
        <h2 id="references-heading">References</h2>
        <ol class="article__references">
          {data.references.map((reference) => (
            <li>
              <a href={reference.url} rel="external noopener noreferrer">
                {reference.title}
                <span class="visually-hidden">(external link)</span>
              </a>
              {reference.annotation && (
                <p class="article__reference-note">{reference.annotation}</p>
              )}
            </li>
          ))}
        </ol>
      </section>
    )}

    {related.length > 0 && (
      <section
        class="article__footer-section"
        aria-labelledby="related-heading"
      >
        <h2 id="related-heading">Related articles</h2>
        <ul class="article-list">
          {related.map((article) => (
            <ArticleCard article={article} headingLevel={3} />
          ))}
        </ul>
      </section>
    )}

    <ArticlePager previous={previous} next={next} />

    <p class="article__back">
      <a href="/articles/">Back to all articles</a>
    </p>

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
    />
  </article>
  <script>
    const blocks = document.querySelectorAll<HTMLElement>("pre.astro-code");

    for (const block of blocks) {
      const language = block.dataset.language;
      if (!language) continue;

      block.setAttribute("role", "region");
      block.setAttribute("aria-label", `${language} code sample`);

      const wrapper = document.createElement("div");
      wrapper.className = "code-block";

      const bar = document.createElement("div");
      bar.className = "code-block__bar";

      const label = document.createElement("span");
      label.className = "code-block__lang";
      label.textContent = language;

      const button = document.createElement("button");
      button.type = "button";
      button.className = "copy-code";
      button.textContent = "Copy";

      const status = document.createElement("span");
      status.className = "copy-code__status";
      status.setAttribute("role", "status");

      bar.append(label, button, status);

      block.parentNode?.insertBefore(wrapper, block);
      wrapper.append(bar, block);
      block.removeAttribute("data-language");

      const code = block.querySelector("code") ?? block;

      const selectCode = () => {
        const range = document.createRange();
        range.selectNodeContents(code);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      };

      button.addEventListener("click", () => {
        const text = code.textContent ?? "";
        const clipboard = navigator.clipboard;
        if (!clipboard) {
          selectCode();
          button.dataset.state = "error";
          status.dataset.state = "error";
          status.textContent =
            "Copy unavailable — code selected, press Ctrl+C to copy.";
          return;
        }
        clipboard.writeText(text).then(
          () => {
            button.dataset.state = "success";
            button.textContent = "Copied";
            status.dataset.state = "";
            status.textContent = "Copied to clipboard.";
          },
          () => {
            selectCode();
            button.dataset.state = "error";
            status.dataset.state = "error";
            status.textContent =
              "Copy failed — code selected, press Ctrl+C to copy.";
          },
        );
      });
    }
  </script>
</BaseLayout>
