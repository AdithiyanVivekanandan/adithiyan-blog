---
import ArticleCard from "../components/ArticleCard.astro";
import {
  AUTHOR,
  SITE_DESCRIPTION,
  SITE_HOME_TITLE,
  SITE_TITLE,
} from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { filterByTopic } from "../lib/article-policy";
import { getPublishedArticles } from "../lib/articles";
import { APPROVED_TOPICS, topicDescription, topicLabel } from "../lib/topics";
import { collectionPageStructuredData } from "../lib/seo";

const articles = await getPublishedArticles();
const [featured, ...rest] = articles;
const recent = rest.slice(0, 3);
const regions = APPROVED_TOPICS.map((slug) => {
  const matches = filterByTopic(articles, slug);
  return {
    slug,
    label: topicLabel(slug),
    description: topicDescription(slug),
    count: matches.length,
  };
}).filter((region) => region.count > 0);
const leadRegion = regions[0];
const site = Astro.site;

if (!site) {
  throw new Error("astro.config.mjs must define site for homepage metadata");
}

const structuredData = [
  collectionPageStructuredData(site, {
    path: "/",
    name: SITE_HOME_TITLE,
    description: SITE_DESCRIPTION,
    articles: articles.map((article) => ({
      slug: article.data.slug,
      title: article.data.title,
    })),
  }),
];
---

<BaseLayout
  title={SITE_HOME_TITLE}
  titleSuffix={false}
  structuredData={structuredData}
>
  <section class="masthead">
    <h1>{SITE_TITLE}</h1>
    <p class="masthead__statement">{SITE_DESCRIPTION}</p>
  </section>

  {featured && (
    <section aria-labelledby="featured-heading">
      <h2 id="featured-heading" class="section-heading">
        Featured
      </h2>
      <ul class="article-list">
        <ArticleCard article={featured} headingLevel={3} />
      </ul>
    </section>
  )}

  {recent.length > 0 && (
    <section aria-labelledby="recent-heading">
      <h2 id="recent-heading" class="section-heading">
        Recent writing
      </h2>
      <ul class="article-list">
        {recent.map((article) => (
          <ArticleCard article={article} headingLevel={3} />
        ))}
      </ul>
    </section>
  )}

  {articles.length === 0 && (
    <p class="empty-state">No articles have been published yet.</p>
  )}

  {regions.length > 0 && (
    <section aria-labelledby="territory-heading">
      <h2 id="territory-heading" class="section-heading">
        Territory map
      </h2>
      <p class="page-intro">
        Regions of this publication with published field notes. Choose one to
        browse its articles.
      </p>
      <ul class="territory-map">
        {regions.map((region) => (
          <li
            class={
              "territory" +
              (leadRegion && region.slug === leadRegion.slug
                ? " territory--lead"
                : "")
            }
          >
            <h3 class="territory__name">
              <a href={`/topics/${region.slug}/`}>{region.label}</a>
            </h3>
            <p class="territory__scope">{region.description}</p>
            <p class="territory__count">
              <a href={`/topics/${region.slug}/`}>
                {region.count}{" "}
                {region.count === 1 ? "field note" : "field notes"}
              </a>
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <p class="view-all">
    <a href="/articles/">All articles</a>
  </p>

  <p class="feed-note">
    New writing is also available as <a href="/rss.xml">an RSS feed</a>.
  </p>

  <p class="author-note">
    Technical Fieldnotes is written and maintained by{" "}
    <a href="/about/">{AUTHOR}</a>. Each article states its environment,
    evidence and limitations so you can reproduce the work or argue with it.
  </p>
</BaseLayout>
