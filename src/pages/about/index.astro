---
import { AUTHOR, AUTHOR_GITHUB, SITE_TITLE } from "../../consts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  APPROVED_TOPICS,
  topicDescription,
  topicLabel,
} from "../../lib/topics";
import { aboutPageStructuredData } from "../../lib/seo";

const title = `About ${AUTHOR}`;
const description = `About ${AUTHOR} and ${SITE_TITLE}: editorial standards, subject areas and how evidence, corrections and limitations are recorded.`;
const site = Astro.site;

if (!site) {
  throw new Error("astro.config.mjs must define site for about metadata");
}

const structuredData = [
  aboutPageStructuredData(site, { name: title, description }),
];
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
>
  <h1 class="page-title">About</h1>

  <div class="about-prose">
    <p>
      {SITE_TITLE} is a personal technical publication about understanding
      systems. It is written and maintained by {AUTHOR}.
    </p>

    <h2>About the author</h2>
    <p>
      {AUTHOR} writes and maintains {SITE_TITLE}. The publication's source,
      article history and corrections are public on{" "}
      <a href={AUTHOR_GITHUB} rel="me external noopener noreferrer">
        GitHub
      </a>
      .
    </p>

    <h2>Subject areas</h2>
    <p>
      Every article belongs to at least one of a fixed set of subject areas:
    </p>
    <ul>
      {APPROVED_TOPICS.map((slug) => (
        <li>
          <a href={`/topics/${slug}/`}>{topicLabel(slug)}</a> —{" "}
          {topicDescription(slug)}
        </li>
      ))}
    </ul>

    <h2>How articles are written</h2>
    <p>
      Each article states the technical context it was verified in, the evidence
      or commands it relies on, and its known limitations. Articles end with
      references to primary sources where relevant.
    </p>
    <p>
      Material corrections are made in the article itself, with the change noted
      in the article's limitations or references where relevant. The
      publication's <a href="/rss.xml">RSS feed</a> carries new articles.
    </p>
  </div>
</BaseLayout>
