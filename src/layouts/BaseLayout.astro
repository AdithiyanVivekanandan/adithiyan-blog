---
import "../styles/tokens.css";
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import {
  AUTHOR,
  AUTHOR_GITHUB,
  SITE_DESCRIPTION,
  SITE_LANGUAGE,
  SITE_TITLE,
} from "../consts";
import { baseStructuredData, type StructuredDataNode } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  image?: string;
  imageAlt?: string;
  articleSection?: string;
  articleTags?: readonly string[];
  structuredData?: StructuredDataNode[];
  titleSuffix?: boolean;
  noindex?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  type = "website",
  publishedAt,
  updatedAt,
  image,
  imageAlt,
  articleSection,
  articleTags = [],
  structuredData = [],
  titleSuffix = true,
  noindex = false,
} = Astro.props;

if (!Astro.site) {
  throw new Error("astro.config.mjs must define site for canonical metadata");
}

const fullTitle =
  titleSuffix && title !== SITE_TITLE ? `${title} — ${SITE_TITLE}` : title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image
  ? new URL(image, Astro.site)
  : new URL("/og.png", Astro.site);
const ogImageType = ogImage.pathname.endsWith(".webp")
  ? "image/webp"
  : ogImage.pathname.endsWith(".jpg") || ogImage.pathname.endsWith(".jpeg")
    ? "image/jpeg"
    : "image/png";
const ogImageAlt =
  imageAlt ?? "An index card on warm paper, labelled Technical Fieldnotes";
const robots = noindex
  ? "noindex, follow"
  : "index, follow, max-image-preview:large";
const graph = {
  "@context": "https://schema.org",
  "@graph": [...baseStructuredData(Astro.site), ...structuredData],
};
const graphJson = JSON.stringify(graph).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={SITE_LANGUAGE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={AUTHOR} />
    <link rel="author" href={new URL("/about/", Astro.site)} />
    <link rel="me" href={AUTHOR_GITHUB} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href="/rss.xml"
    />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {type === "article" && publishedAt && (
      <meta
        property="article:published_time"
        content={publishedAt.toISOString()}
      />
    )}
    {type === "article" && updatedAt && (
      <meta
        property="article:modified_time"
        content={updatedAt.toISOString()}
      />
    )}
    {type === "article" && (
      <meta
        property="article:author"
        content={new URL("/about/", Astro.site)}
      />
    )}
    {type === "article" && articleSection && (
      <meta property="article:section" content={articleSection} />
    )}
    {type === "article" &&
      articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script is:inline type="application/ld+json" set:html={graphJson} />
    <meta
      name="theme-color"
      content="#f3efe5"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#171c19"
      media="(prefers-color-scheme: dark)"
    />
    <script is:inline>
      (function () {
        document.documentElement.classList.add("js");
        try {
          const stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          // storage unavailable — the CSS media fallback still applies
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <div
      id="field-note"
      class="field-note"
      role="dialog"
      aria-label="A small field note"
      hidden
    >
      <span class="field-note__stamp" aria-hidden="true">
        FN—01
      </span>
      <p class="field-note__text">
        You found a note. Every article here began as a small observation like
        this one — thanks for exploring.
      </p>
      <button type="button" class="field-note__close">
        Close note
      </button>
    </div>
    <SiteFooter />
    <script is:inline>
      (function () {
        const card = document.getElementById("field-note");
        if (!card) return;
        const closeButton = card.querySelector("button");
        let lastFocus = null;

        const openNote = function () {
          if (!card.hidden) return;
          lastFocus = document.activeElement;
          card.hidden = false;
          closeButton.focus();
        };

        const closeNote = function () {
          if (card.hidden) return;
          card.hidden = true;
          if (lastFocus && typeof lastFocus.focus === "function") {
            lastFocus.focus();
          }
          lastFocus = null;
        };

        let buffer = "";
        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape") {
            closeNote();
            return;
          }
          if (
            event.ctrlKey ||
            event.altKey ||
            event.metaKey ||
            event.isComposing
          ) {
            return;
          }
          const target = event.target;
          if (
            target &&
            (target.closest("input, textarea, select") ||
              target.isContentEditable)
          ) {
            return;
          }
          if (event.key && event.key.length === 1) {
            buffer = (buffer + event.key.toLowerCase()).slice(-4);
            if (buffer === "note") openNote();
          }
        });
        closeButton.addEventListener("click", closeNote);
      })();
    </script>
  </body>
</html>
