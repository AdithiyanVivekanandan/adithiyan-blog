{
  "name": "adithiyan-blog",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "dev:cms": "npm run cms:doctor && npm run build && wrangler pages dev dist --port 8788 --live-reload",
    "cms:doctor": "node scripts/cms-doctor.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "indexnow:dry": "node scripts/indexnow.mjs --dry-run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "lint:secrets": "secretlint \"**/*\"",
    "audit:deps": "npm audit --audit-level=high",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run lint:secrets && npm run audit:deps && npm run build && npm test"
  },
  "dependencies": {
    "astro": "^7.4.0",
    "dompurify": "^3.4.17",
    "jose": "^6.2.13",
    "marked": "^18.1.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "secretlint": "^13.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "wrangler": "^4.153.0"
  }
}
